# Copier en `ai/.env` (ignoré par git) et compléter. Ne JAMAIS committer de clé.

# Fournisseur : auto | anthropic | offline
#   auto = anthropic si une clé est présente, sinon repli déterministe.
AI_PROVIDER=auto

# Clé API Anthropic (https://console.anthropic.com). Laisser vide = mode hors-ligne.
ANTHROPIC_API_KEY=

# Modèle et profondeur de raisonnement
AI_MODEL=claude-opus-5
AI_EFFORT=medium
AI_MAX_TOKENS=8000

# Robustesse
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_DESCRIPTION_CHARS=12000
AI_MAX_KEYWORDS=20

# --- Sources d'offres à API officielle --------------------------------
# Une source sans identifiants est ignorée en silence : c'est la raison la
# plus fréquente d'un « aucune offre France Travail » alors que tout marche.
# (LinkedIn, Indeed et HelloWork n'ont pas d'API : ils passent par le service
#  `bot`, et ne se configurent donc pas ici.)

# France Travail — inscription gratuite sur https://francetravail.io
# Créer une application, souscrire à « Offres d'emploi v2 », puis recopier :
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna — inscription gratuite sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# Remotive ne demande aucune clé : elle est toujours active.
SEARCH_TIMEOUT_SECONDS=20

LOG_LEVEL=info
