# Serveur
PORT=4000
MONGO_URI=mongodb://localhost:27017/findurjob

# Moteur IA (Python) — vide = stub déterministe intégré au serveur.
# Docker Compose : http://ai:8000 (déjà branché dans docker-compose.yml)
# Hors Docker, moteur lancé en local : http://localhost:8000
PYTHON_AI_URL=

# Navigateur piloté (service `bot`) — rendu PDF du CV, lecture des offres
# LinkedIn/Indeed/HelloWork et candidatures. Vide = ces fonctions sont
# désactivées, avec un message explicite plutôt qu'une erreur muette.
# Docker Compose : http://bot:8100
BOT_URL=

# Clé de chiffrement du coffre d'identifiants de plateformes (AES-256-GCM).
# 32 octets, en hexadécimal ou en base64 :
#     openssl rand -hex 32
# Sans elle, aucun mot de passe ne peut être enregistré — le serveur refuse
# explicitement plutôt que de stocker en clair. Elle vit hors de la base : une
# copie de Mongo seule ne donne rien. La perdre rend les mots de passe déjà
# stockés illisibles, il faut alors les ressaisir.
CREDENTIALS_KEY=
